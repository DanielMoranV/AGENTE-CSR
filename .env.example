# ==============================================================================
# AGENTE-CSR — PLANTILLA DE CONFIGURACIÓN DE ENTORNO (.env.example)
# ==============================================================================
# Copia este archivo como .env y completa las credenciales correspondientes.
# NUNCA compartas ni subas el archivo .env a repositorios públicos o compartidos.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS POSTGRESQL (SISCLIN / SISLAB)
# ------------------------------------------------------------------------------
# Servidor institucional PostgreSQL (ejemplo: IP local o hostname)
POSTGRES_HOST=192.168.1.100
POSTGRES_PORT=5432
POSTGRES_DB=sisclin

# Usuario de servicio estricto de solo lectura (Definido en connection.py y scripts/crear_usuario_postgres.sql)
# NOTA: AGENTE-CSR rechaza cualquier cuenta que no sea 'ai_readonly'
POSTGRES_USER=ai_readonly
POSTGRES_PASSWORD=tu_password_postgres_aqui

# Timeout máximo de ejecución de sentencias en segundos
QUERY_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# 2. CARPETAS COMPARTIDAS FOXPRO / DBF (RUTAS UNC)
# ------------------------------------------------------------------------------
# Rutas compartidas de red hacia los datos de SISCLIN y SISLAB (solo lectura binaria 'rb')
DBF_FOLDER_PATH=\\servidor-archivos\Sistemas\sisclin\DATA
SISLAB_DBF_FOLDER_PATH=\\servidor-archivos\Sistemas\Sislab\data

# Codificación de caracteres de las tablas DBF
DBF_ENCODING=cp1252
SISLAB_DBF_ENCODING=latin-1

# ------------------------------------------------------------------------------
# 3. AUTENTICACIÓN WINDOWS / SMB (RECURSOS COMPARTIDOS DE RED)
# ------------------------------------------------------------------------------
# Credenciales de red con permisos de lectura en \\servidor-archivos\Sistemas
SMB_HOST=192.168.1.100
SMB_USER=tu_usuario_windows_aqui
SMB_PASSWORD=tu_password_windows_aqui
SMB_DOMAIN=DOMINIO_EMPRESA

# En Linux / WSL2, estas rutas se montan como:
# sudo mount -t cifs //servidor-archivos/Sistemas/sisclin/DATA /mnt/sisclin -o ro,username=$SMB_USER,password=$SMB_PASSWORD,domain=$SMB_DOMAIN
# DBF_FOLDER_PATH_LINUX=/mnt/sisclin
# SISLAB_DBF_FOLDER_PATH_LINUX=/mnt/sislab

# ------------------------------------------------------------------------------
# 4. PARÁMETROS OPERATIVOS Y DE SEGURIDAD
# ------------------------------------------------------------------------------
NOMBRE_INSTITUCION="Clínica Institucional"
MAX_EXPORT_ROWS=100000
LOG_LEVEL=INFO
